# Copy to .env; docker compose reads it automatically.
LOG_LEVEL=info
# Protect /admin/* (chaos) endpoints; clients send it as x-admin-token.
ADMIN_TOKEN=
# Password sign-in for the Operations tab's chaos controls (both, or neither).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# notification-service also posts {"text": ...} here (Slack incoming webhook, webhook.site, ...).
WEBHOOK_URL=
# Events API v2 routing key for the observability profile's Alertmanager (pages PagerDuty).
PAGERDUTY_ROUTING_KEY=
# Synthetic users (observability profile; always on in Coolify). SYNTHETICS_ENABLED=false starts them paused.
SYNTHETICS_USERS=3
SYNTHETICS_ENABLED=true
# Clear-down: finished synthetic bookings, released holds, refunded payments and synthetic notifications
# older than this are deleted automatically, every minute. Real customers' bookings are never deleted.
CLEARDOWN_RETENTION_MINUTES=60
